# ── LLM Providers ──────────────────────────────────────────────
# Gemini (primary agent brain)
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash      # or gemini-2.5-pro for hard cases

# Local vLLM endpoint (Qwen-VL, OpenAI-compatible)
LOCAL_VLM_BASE_URL=http://localhost:8000/v1
LOCAL_VLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct    # or Qwen3-VL-30B-A3B on A800
LOCAL_VLM_API_KEY=EMPTY                          # vLLM default

# Active provider: "gemini" | "local"
AGENT_MODEL_PROVIDER=gemini

# ── Observability ───────────────────────────────────────────────
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=forensics-agent
LANGCHAIN_TRACING_V2=true

# ── MCP Server ─────────────────────────────────────────────────
MCP_SERVER_HOST=localhost
MCP_SERVER_PORT=9000

# ── Evaluation ─────────────────────────────────────────────────
# Paths to benchmark datasets (fill in your local paths)
CASIA_ROOT=/data/datasets/CASIA
NIST16_ROOT=/data/datasets/NIST16
COVERAGE_ROOT=/data/datasets/Coverage
IMDL_BENCO_WEIGHTS=/data/weights/imdlbenco
